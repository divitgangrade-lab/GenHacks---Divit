 "scenes": [
  {
   "id": "hook",
   "v": "v01",
   "vAt": 0.5,
   "extra": 0.45,
   "cap": "This sentence is on a product page. In the EU, it is now banned — unless the seller can prove the claim.",
   "capKey": "banned",
   "t": 0,
   "dur": 9.988999999999999,
   "voiceAt": 0.5,
   "voiceEnd": 8.639
  },
  {
   "id": "title",
   "v": "v02",
   "vAt": 0.6,
   "extra": 0.2,
   "cap": "Claim Check marks the claims that are now illegal, on the page you are shopping on.",
   "capKey": "illegal",
   "t": 9.988999999999999,
   "dur": 7.0489999999999995,
   "voiceAt": 10.588999999999999,
   "voiceEnd": 16.037999999999997
  },
  {
   "id": "law",
   "v": "v03",
   "vAt": 0.55,
   "extra": 0.35,
   "cap": "Directive 2024/825 applies from 27 September 2026. It covers stock already on the shelves.",
   "capKey": "27 September 2026",
   "t": 17.037999999999997,
   "dur": 13.786,
   "voiceAt": 17.587999999999997,
   "voiceEnd": 29.623999999999995
  },
  {
   "id": "three",
   "v": "v04",
   "vAt": 0.55,
   "extra": 0.4,
   "cap": "Eco-friendly. Climate neutral. Biodegradable. Without proof, the words are the problem.",
   "capKey": "Biodegradable",
   "t": 30.823999999999998,
   "dur": 11.865,
   "voiceAt": 31.374,
   "voiceEnd": 41.439
  },
  {
   "id": "product",
   "v": "v05",
   "vAt": 0.55,
   "extra": 0.35,
   "cap": "It reads the visible text of the page: four banned claims here, two that need evidence.",
   "capKey": "four banned claims",
   "t": 42.689,
   "dur": 10.047,
   "voiceAt": 43.239,
   "voiceEnd": 51.536
  },
  {
   "id": "anatomy",
   "v": "v06",
   "vAt": 0.55,
   "extra": 0.35,
   "cap": "Each finding quotes the sentence, marks the phrase, and names the article.",
   "capKey": "marks the phrase",
   "t": 52.736000000000004,
   "dur": 9.964,
   "voiceAt": 53.286,
   "voiceEnd": 61.5
  },
  {
   "id": "rules",
   "v": "v07",
   "vAt": 0.55,
   "extra": 1.35,
   "cap": "Six rules. Four banned practices, and two that need evidence.",
   "capKey": "Six rules",
   "t": 62.7,
   "dur": 7.321,
   "voiceAt": 63.25,
   "voiceEnd": 67.821
  },
  {
   "id": "decoy",
   "v": "v08",
   "vAt": 0.55,
   "extra": 0.8,
   "cap": "It stays quiet when the words are ordinary. Green tea is not a green claim.",
   "capKey": "Green tea",
   "t": 70.021,
   "dur": 7.574999999999999,
   "voiceAt": 70.571,
   "voiceEnd": 75.946
  },
  {
   "id": "install",
   "v": "v09",
   "vAt": 0.55,
   "extra": 0.55,
   "cap": "One bookmark, any product page. No account, no extension.",
   "capKey": "One bookmark",
   "t": 77.596,
   "dur": 6.3759999999999994,
   "voiceAt": 78.146,
   "voiceEnd": 82.572
  },
  {
   "id": "privacy",
   "v": "v10",
   "vAt": 0.55,
   "extra": 0.45,
   "cap": "The page text never leaves the browser. That is what makes it safe on a checkout page.",
   "capKey": "never leaves the browser",
   "t": 83.97200000000001,
   "dur": 7.68,
   "voiceAt": 84.522,
   "voiceEnd": 90.352
  },
  {
   "id": "receipts",
   "v": "v11",
   "vAt": 0.55,
   "extra": 0.45,
   "cap": "Thirteen saved pages. Three findings, all reviewed. A pilot, not a survey.",
