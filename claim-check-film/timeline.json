   "vAt": 0.5,
   "extra": 0.45,
   "cap": "This sentence is on a product page. In the EU, it is now banned — unless the seller can prove the claim.",
   "capKey": "banned",
   "t": 0,
   "dur": 9.798,
   "voiceAt": 0.5,
   "voiceEnd": 8.448
  },
  {
   "id": "title",
   "v": "v02",
   "vAt": 0.6,
   "extra": 0.2,
   "cap": "Claim Check marks the claims that are now illegal, on the page you are shopping on.",
   "capKey": "illegal",
   "t": 9.798,
   "dur": 7.08,
   "voiceAt": 10.398,
   "voiceEnd": 15.878
  },
  {
   "id": "law",
   "v": "v03",
   "vAt": 0.55,
   "extra": 0.35,
   "cap": "Directive 2024/825 applies from 27 September 2026. It covers stock already on the shelves.",
